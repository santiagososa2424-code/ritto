# Copiar a .env.local y completar con los valores que están en Vercel.
# Este archivo va al repo: acá NUNCA se escribe un valor real.

# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Sólo servidor. Saltea RLS: si se filtra, se filtra todo.
SUPABASE_SERVICE_ROLE_KEY=

# Google OAuth — para escribir en la planilla del usuario
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=
# Firma el `state` del OAuth. Cualquier cadena larga y aleatoria.
OAUTH_STATE_SECRET=

# Gemini — extracción del comprobante y mapeo de columnas
GEMINI_API_KEY=

# Mercado Pago — suscripciones
MP_ACCESS_TOKEN=
MP_WEBHOOK_SECRET=

# Resend — mail de bienvenida
RESEND_API_KEY=

# URL pública del sitio (https://ritto.lat en producción)
NEXT_PUBLIC_SITE_URL=

# Quién puede ver /admin/errores. Si se omite, usa el mail de soporte.
ADMIN_EMAIL=
